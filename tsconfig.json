{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"],
    "paths": {"@/*": ["./*"]}
  },
  "include": ["src", "app", "components", "lib", "vite.config.ts"],
  "exclude": ["node_modules", "docs", ".test-build"]
}
